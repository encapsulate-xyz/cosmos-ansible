config_dir = "{{ price_feeder_config_dir }}"
provider_timeout = "1000000s"
gas_prevote = 55000
gas_vote = 160000

[server]
listen_addr = "0.0.0.0:{{ price_feeder_port }}"
read_timeout = "20s"
verbose_cors = true
write_timeout = "20s"

[account]
address = "{{ pf_address }}"
chain_id = "umee-1"
validator = "{{ validator_address }}"

[keyring]
backend = "os"
dir = "{{ umee.pf.keyring_dir }}"

[rpc]
grpc_endpoint = "127.0.0.1:{{ grpc_port }}"
rpc_timeout = "100ms"
tmrpc_endpoint = "http://127.0.0.1:{{ rpc_port }}"

[telemetry]
enable-hostname = true
enable-hostname-label = true
enable-service-label = true
enabled = true
global-labels = [ [ "chain_id", "umee-1",],]
service-name = "{{ service_identifier }}"
prometheus-retention-time = 100
